{
  "openapi": "3.1.0",
  "info": {
    "title": "ML API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "summary": "Analyze",
        "description": "Ocena materiału przez jeden moduł AI: wynik każdej reguły z cytatem (KONTRAKT.md §2).",
        "operationId": "analyze",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scrape": {
      "post": {
        "summary": "Scrape Url",
        "operationId": "scrape_url",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScrapeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeResult"
                }
              }
            }
          },
          "502": {
            "description": "Strony nie udało się pobrać"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/collect/youtube": {
      "post": {
        "summary": "Collect Youtube",
        "description": "Filmy z YouTube z etykietą płatnej promocji, transkrypcją i stronami z linków w opisie.",
        "operationId": "collect_youtube",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YoutubeCollectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeCollection"
                }
              }
            }
          },
          "502": {
            "description": "Wyszukiwanie w YouTube zawiodło"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/collect/youtube/channel": {
      "post": {
        "summary": "Collect Youtube Channel",
        "description": "Najnowsze filmy kanału (wszystkie, nie tylko płatne promocje) z transkrypcją i linkami.",
        "operationId": "collect_youtube_channel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YoutubeChannelCollectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeCollection"
                }
              }
            }
          },
          "502": {
            "description": "Listy filmów kanału nie udało się pobrać"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knf/warnings": {
      "get": {
        "summary": "Knf Warnings",
        "description": "Lista ostrzeżeń publicznych KNF (wszystkie sekcje).",
        "operationId": "knf_warnings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/KnfWarning"
                  },
                  "type": "array",
                  "title": "Response Knf Warnings"
                }
              }
            }
          },
          "502": {
            "description": "Strony KNF nie udało się pobrać"
          }
        }
      }
    },
    "/knf/entities": {
      "get": {
        "summary": "Knf Entities",
        "description": "Wyszukiwarka podmiotów KNF: czy firma jest w rejestrze i z jakim zakresem działalności.",
        "operationId": "knf_entities",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "Nazwa, KRS/NIP albo domena.",
              "title": "Q"
            },
            "description": "Nazwa, KRS/NIP albo domena."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 50,
              "title": "Per Page"
            }
          },
          {
            "name": "include_deleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Deleted"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnfEntitySearch"
                }
              }
            }
          },
          "502": {
            "description": "Strony KNF nie udało się pobrać"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisFinding": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "result": {
            "type": "string",
            "enum": [
              "violation",
              "ok",
              "n/a"
            ],
            "title": "Result"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote",
            "description": "Dosłowny fragment `text`, do 300 znaków."
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "frame": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FindingFrame"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tylko reguły wizualne z klatek filmu (KONTRAKT.md §2)."
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "result",
          "confidence",
          "quote",
          "reason"
        ],
        "title": "AnalysisFinding"
      },
      "AnalysisSubject": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Nazwa podmiotu z treści (forma prawna: sp. z o.o., S.A., Ltd…)."
          },
          "identifiers": {
            "items": {
              "$ref": "#/components/schemas/KnfIdentifier"
            },
            "type": "array",
            "title": "Identifiers",
            "description": "NIP, KRS, REGON z treści."
          },
          "emails": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Emails"
          },
          "phones": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Phones"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AnalysisSubject"
      },
      "AnalyzePage": {
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "format": "uri",
            "title": "Url",
            "description": "Adres strony (baza dla względnych arkuszy CSS)."
          },
          "html": {
            "type": "string",
            "maxLength": 6000000,
            "title": "Html",
            "description": "Surowy HTML z dnia scrapingu."
          }
        },
        "type": "object",
        "required": [
          "url",
          "html"
        ],
        "title": "AnalyzePage"
      },
      "AnalyzeRequest": {
        "properties": {
          "material_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Material Id"
          },
          "module": {
            "type": "string",
            "enum": [
              "finfluencer",
              "risk_disclosure",
              "unauthorized_advisory"
            ],
            "title": "Module"
          },
          "text": {
            "type": "string",
            "maxLength": 500000,
            "title": "Text",
            "description": "materials.text"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rules",
            "description": "Reguły do oceny; pusta lista = wszystkie reguły modułu."
          },
          "video": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalyzeVideo"
              },
              {
                "type": "null"
              }
            ],
            "description": "M2, reguła 7: części filmu YouTube (tytuł, opis, transkrypcja) osobno."
          },
          "page": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalyzePage"
              },
              {
                "type": "null"
              }
            ],
            "description": "M2, reguły 7 i 8 dla strony WWW: HTML renderowany w Chromium (bez JS)."
          }
        },
        "type": "object",
        "required": [
          "material_id",
          "module",
          "text"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "material_id": {
            "type": "string",
            "title": "Material Id"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label",
            "description": "M1/M3; w M2 null."
          },
          "probability": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability",
            "description": "M1/M3; w M2 null."
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/AnalysisFinding"
            },
            "type": "array",
            "title": "Findings"
          },
          "risk_score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score",
            "description": "Do sortowania listy zadań: score materiału z wszystkich reguł (noisy-OR z zanikiem po rule_scores). Nie porównuj go z progiem."
          },
          "max_rule_score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Rule Score",
            "description": "Do progu: najwyższy rule_scores[*].score. Materiał jest incydentem przy progu t, gdy max_rule_score >= t (czyli gdy któraś reguła ma score >= t)."
          },
          "rule_scores": {
            "additionalProperties": {
              "$ref": "#/components/schemas/RuleScoreOut"
            },
            "type": "object",
            "title": "Rule Scores",
            "description": "Score każdej reguły, klucz = id reguły."
          },
          "subject": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisSubject"
              },
              {
                "type": "null"
              }
            ],
            "description": "M3: dane podmiotu z treści oferty (do raportu i rejestru KNF)."
          },
          "signals": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Signals",
            "description": "M3: score 0-1 każdej przesłanki doradztwa."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Silnik, który policzył wynik."
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "material_id",
          "label",
          "probability",
          "summary",
          "findings"
        ],
        "title": "AnalyzeResponse"
      },
      "AnalyzeVideo": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000,
            "title": "Title",
            "default": ""
          },
          "description": {
            "type": "string",
            "maxLength": 20000,
            "title": "Description",
            "default": ""
          },
          "transcript": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500000
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript",
            "description": "Tekst transkrypcji; null = film bez transkrypcji."
          }
        },
        "type": "object",
        "title": "AnalyzeVideo"
      },
      "FindingFrame": {
        "properties": {
          "ts": {
            "type": "number",
            "minimum": 0.0,
            "title": "Ts",
            "description": "Sekunda klatki od początku filmu."
          },
          "file": {
            "type": "string",
            "title": "File",
            "description": "Plik klatki materiału, np. 42000.png."
          },
          "box": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Box",
            "description": "Ramka cytatu [x0, y0, x1, y1] jako ułamki 0-1 klatki."
          }
        },
        "type": "object",
        "required": [
          "ts",
          "file",
          "box"
        ],
        "title": "FindingFrame"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "KnfEntity": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "former_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Former Names"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          },
          "register_name": {
            "type": "string",
            "title": "Register Name",
            "description": "Rejestr KNF, np. „Firmy inwestycyjne - Domy maklerskie”."
          },
          "register_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Register Id"
          },
          "investment_register": {
            "type": "boolean",
            "title": "Investment Register",
            "description": "Aktualny wpis w rejestrze usług inwestycyjnych (firmy inwestycyjne, domy maklerskie, notyfikacje z EOG, agenci). False dla danych historycznych i cofniętych zezwoleń."
          },
          "attributes": {
            "items": {
              "$ref": "#/components/schemas/KnfEntityAttribute"
            },
            "type": "array",
            "title": "Attributes"
          },
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Domains"
          },
          "detail_url": {
            "type": "string",
            "title": "Detail Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "former_names",
          "deleted",
          "register_name",
          "register_id",
          "investment_register",
          "attributes",
          "domains",
          "detail_url"
        ],
        "title": "KnfEntity"
      },
      "KnfEntityAttribute": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "title": "KnfEntityAttribute"
      },
      "KnfEntitySearch": {
        "properties": {
          "phrase": {
            "type": "string",
            "title": "Phrase"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "per_page": {
            "type": "integer",
            "title": "Per Page"
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/KnfEntity"
            },
            "type": "array",
            "title": "Entities"
          }
        },
        "type": "object",
        "required": [
          "phrase",
          "total",
          "page",
          "per_page",
          "entities"
        ],
        "title": "KnfEntitySearch"
      },
      "KnfIdentifier": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "KRS",
              "NIP",
              "REGON"
            ],
            "title": "Kind"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "title": "KnfIdentifier"
      },
      "KnfWarning": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Podstawa prawna zawiadomienia (sekcja listy KNF)."
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "entities": {
            "type": "string",
            "title": "Entities"
          },
          "identifiers": {
            "items": {
              "$ref": "#/components/schemas/KnfIdentifier"
            },
            "type": "array",
            "title": "Identifiers"
          },
          "prosecutor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prosecutor"
          },
          "rulings": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rulings"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Domains"
          }
        },
        "type": "object",
        "required": [
          "category",
          "number",
          "entities",
          "identifiers",
          "prosecutor",
          "rulings",
          "notes",
          "domains"
        ],
        "title": "KnfWarning"
      },
      "PredictRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "PredictRequest"
      },
      "Prediction": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "neutral"
            ],
            "title": "Label"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "label",
          "score"
        ],
        "title": "Prediction"
      },
      "RuleScoreOut": {
        "properties": {
          "p_violation": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Violation",
            "description": "P(naruszenie) reguły."
          },
          "weight": {
            "type": "number",
