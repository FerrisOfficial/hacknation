# Wzór .env dla Docker Compose (compose.yaml). `pnpm install` kopiuje go sam (albo: cp .env.example .env).
# Plik .env nie trafia do gita ani do obrazów (.dockerignore).

# Hasło bazy w kontenerze `db`. Bez znaków @ : / ? # — trafia do adresu URL. Zmieniasz je?
# Zmień też DATABASE_URL w apps/web/.env.local i packages/db/.env.
POSTGRES_PASSWORD=hacknation-local

# Model w Ollamie, pobierany przy pierwszym starcie. gemma4:e2b to ok. 5 GB i mieści się w 6 GB VRAM.
OLLAMA_MODEL=gemma4:e2b

# Moduł 2 (informacja o ryzyku): rules — sam regex, bez LLM; hybrid — regex wskazuje fragmenty,
# LLM ocenia je TAK/NIE (zalecany, wymaga modelu niżej); llm — sam LLM na całym tekście.
M2_ENGINE=rules
# Model LLM dla M2. Bielik-PL-11B z polskim tokenizerem APT4 (Q8_0, ok. 12 GB, pobiera ollama-pull).
OLLAMA_RISK_MODEL=hf.co/speakleash/Bielik-PL-11B-v3.0-Instruct-GGUF:Q8_0
# Ollama poza Dockerem (np. Mac — kontener nie widzi GPU Apple): http://host.docker.internal:11434
# Puste = Ollama z compose.yaml.
OLLAMA_URL=

# Opcjonalny proxy dla scrapera w serwisie ML (np. http://user:pass@host:3128). Puste = bez proxy.
SCRAPER_PROXY_URL=
# Przerwa (s, ±50%) przed każdym zapytaniem kolektora do YouTube. 0 = bez przerw.
YOUTUBE_DELAY_S=3

# Token dla POST /hacknation/api/collect/* (cron, skrypty): `Authorization: Bearer <token>`.
# Puste = kolektory wyłączone. Wygeneruj np.: node -e "console.log(crypto.randomUUID())"
COLLECTOR_TOKEN=

# Skąd przeglądarka łączy się z Socket.io (CORS), np. gdy dashboard otwierasz pod innym adresem.
REALTIME_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Ile zadań kolejki naraz: scrapowanie źródeł i analiza AI.
SCRAPE_CONCURRENCY=2
ANALYZE_CONCURRENCY=1
# Harmonogram przestaje zbierać po tylu materiałach w bazie (0 = bez limitu).
MATERIALS_LIMIT=2000
# Ile źródeł harmonogram uruchamia na minutę (YouTube blokuje HTTP 429 przy większym tempie).
SCHEDULER_BATCH=1
