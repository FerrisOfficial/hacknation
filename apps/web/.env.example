# Skopiuj do apps/web/.env.local i uzupełnij. .env.local NIE trafia do gita.

# Supabase → Project Settings → API (URL projektu i "publishable key")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Connect → "Transaction pooler" (używane przez @app/db na serwerze)
DATABASE_URL=

# Adres serwisu ML (FastAPI). Lokalnie 127.0.0.1, nie localhost (IPv4 vs IPv6 na Windowsie).
ML_API_URL=http://127.0.0.1:8000
