# Wzór apps/web/.env.local (plik NIE trafia do gita). `pnpm install` kopiuje go sam, jeśli brakuje.
# Wszystko działa lokalnie — wartości poniżej pasują do `pnpm db:up` i `pnpm dev`.

# Lokalny Postgres z compose.yaml (`pnpm db:up`). Hasło = POSTGRES_PASSWORD z .env w roocie.
DATABASE_URL=postgres://hacknation:hacknation-local@127.0.0.1:5432/hacknation

# Adres serwisu ML (FastAPI). Lokalnie 127.0.0.1, nie localhost (IPv4 vs IPv6 na Windowsie).
ML_API_URL=http://127.0.0.1:8000

# Token dla POST /api/collect/* (cron, skrypty): `Authorization: Bearer <token>`. Puste = kolektory
# wyłączone. Wygeneruj np.: node -e "console.log(crypto.randomUUID())"
COLLECTOR_TOKEN=

# Serwer Socket.io (powiadomienia w czasie rzeczywistym) — osobny port, start z src/instrumentation.ts.
REALTIME_PORT=3001
REALTIME_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Worker kolejki (pg-boss) i harmonogram w tym procesie. false = proces tylko wysyła zadania.
WORKER_ENABLED=true
# Ile zadań naraz: scrapowanie źródeł i analiza AI (lokalny model zwykle liczy jedno naraz).
SCRAPE_CONCURRENCY=2
ANALYZE_CONCURRENCY=1
# Harmonogram przestaje zbierać po tylu materiałach w bazie (0 = bez limitu).
MATERIALS_LIMIT=2000

# Baza treści: surowy HTML materiałów (gzip, adresowany SHA-256). Względnie do apps/web.
CONTENT_STORE_DIR=.data/content
