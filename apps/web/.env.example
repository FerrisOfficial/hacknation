# Wzór apps/web/.env.local (plik NIE trafia do gita). `pnpm install` kopiuje go sam, jeśli brakuje.
# Wszystko działa lokalnie — wartości poniżej pasują do `pnpm db:up` i `pnpm dev`.

# Lokalny Postgres z compose.yaml (`pnpm db:up`). Hasło = POSTGRES_PASSWORD z .env w roocie.
DATABASE_URL=postgres://hacknation:hacknation-local@127.0.0.1:5432/hacknation

# Adres serwisu ML (FastAPI). Lokalnie 127.0.0.1, nie localhost (IPv4 vs IPv6 na Windowsie).
ML_API_URL=http://127.0.0.1:8000

# Token dla POST /api/collect/* (cron, skrypty): `Authorization: Bearer <token>`. Puste = kolektory
# wyłączone. Wygeneruj np.: node -e "console.log(crypto.randomUUID())"
COLLECTOR_TOKEN=
