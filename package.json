{
  "name": "hacknation",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/env-init.mjs",
    "dev": "node scripts/env-init.mjs && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "biome check --write . && pnpm --filter @app/ml format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run lint typecheck test",
    "env:init": "node scripts/env-init.mjs",
    "db:up": "node scripts/env-init.mjs && docker compose up --detach --wait db && pnpm --filter @app/db migrate",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db migrate",
    "db:check": "pnpm --filter @app/db check-connection",
    "db:studio": "pnpm --filter @app/db studio",
    "api:generate": "pnpm --filter @app/ml openapi && pnpm --filter @app/api-ml generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
